name: aqone
description: AqOne fisherman app - offline SOS handoff to LoRa buoys.
publish_to: 'none'
version: 0.1.0+1

environment:
  sdk: ^3.5.0

dependencies:
  flutter:
    sdk: flutter
  http: ^1.2.2
  sqflite: ^2.3.3
  sqflite_common_ffi_web: any
  path: ^1.9.0

  # Bumped from ^13.0.1 to match the version the Venture code is proven
  # against. LocationService already uses the modern locationSettings API,
  # so no call-site changes were needed.
  geolocator: ^14.0.3

  # Venture map. Versions pinned to what the source project resolved.
  flutter_map: ^8.3.1
  latlong2: ^0.10.1

  # Tappable emergency contact numbers.
  url_launcher: ^6.3.2

  # WiFi Chathub (Heltec WiFi relay). Versions pinned to what the source
  # project resolved.
  web_socket_channel: ^3.0.1
  shared_preferences: ^2.3.2
  network_info_plus: ^8.2.1

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true

  assets:
    - assets/images/aqone_logo.png
