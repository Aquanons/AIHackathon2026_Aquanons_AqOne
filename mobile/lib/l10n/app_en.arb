  "deliveryStateSavedTitle": "Saved",
  "@deliveryStateSavedTitle": {
    "description": "SAFETY CRITICAL. First of four delivery states. The SOS is on the phone only and has reached nobody. Must not sound reassuring - the user has to understand help is not yet coming."
  },
  "deliveryStateSavedDescription": "Not sent — no buoy nearby. Will send automatically.",
  "@deliveryStateSavedDescription": {
    "description": "SAFETY CRITICAL. Explains the Saved state. Two facts: it has not been sent, and the phone will keep trying without the user doing anything."
  },
  "deliveryStateRelayedTitle": "Relayed",
  "@deliveryStateRelayedTitle": {
    "description": "SAFETY CRITICAL. Second of four delivery states. A buoy accepted the SOS and is passing it over the LoRa radio mesh. Nobody has received it yet."
  },
  "deliveryStateRelayedDescription": "Handed to the buoy. Waiting for the mesh.",
  "@deliveryStateRelayedDescription": {
    "description": "SAFETY CRITICAL. Explains the Relayed state. 'Mesh' means the chain of radio buoys - use whatever a fisherman would actually call it, not a literal translation."
  },
  "deliveryStateDeliveredTitle": "Delivered",
  "@deliveryStateDeliveredTitle": {
    "description": "SAFETY CRITICAL. Third of four delivery states. The MDRRMO dashboard received the SOS, but no human has confirmed seeing it."
  },
  "deliveryStateDeliveredDescription": "Received by the MDRRMO dashboard.",
  "@deliveryStateDeliveredDescription": {
    "description": "SAFETY CRITICAL. Explains the Delivered state. Keep 'MDRRMO' untranslated - it is the official agency acronym."
  },
  "deliveryStateAcknowledgedTitle": "Acknowledged",
  "@deliveryStateAcknowledgedTitle": {
    "description": "SAFETY CRITICAL. Fourth and final delivery state. A human responder has seen the SOS and is acting on it. This is the only state that means help is coming."
  },
  "deliveryStateAcknowledgedDescription": "Responder acknowledged this SOS.",
  "@deliveryStateAcknowledgedDescription": {
    "description": "SAFETY CRITICAL. Explains the Acknowledged state."
  },
