DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqone

# Signs dashboard session tokens. If unset the service still boots, but uses an
# ephemeral secret and every restart logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Session lifetime in hours. Defaults to 12.
JWT_EXPIRY_HOURS=12

# Required to create dashboard accounts via /api/admin-signup. Leave unset and
# account creation is disabled entirely (the endpoint returns 503). Generate
# one the same way as JWT_SECRET.
ADMIN_SETUP_KEY=

# Guards POST /api/ai/squall/train. Leave unset during a demo.
ALLOW_TRAINING=

# Registers the presenter-controlled demo routes. Leave unset in production.
DEMO_MODE=

# Header value required by /api/demo/* routes when DEMO_MODE is enabled.
DEMO_CONTROL_KEY=

# Required X-Api-Key value for POST /api/v1/contacts (gateway-only trip
# contact-event ingest) and POST /api/v1/pressure-events (gateway-only buoy
# pressure ingest, docs/04_INGEST_API.md). Leave unset to reject every
# submission - there is no bypass, unlike the always-open SOS ingest path.
GATEWAY_API_KEY=
